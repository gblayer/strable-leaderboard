# The shared environment of every model on the leaderboard, at the versions of the STRABLE paper
# (salts_env, 2026-03-23, Python 3.12.12). env/requirements.txt is generated from this list by
# scripts/lock_env.sh, with the paper's full environment (env/paper-freeze.txt) as constraints, so
# every dependency also keeps the paper's version.
# A contributor may only ADD a line here, `name==version`, for a package a model needs that is not
# in the shared environment; an existing pin never changes in a pull request. Either way the pull
# request waits for the maintainer, who relocks and rebuilds the environment.

# data, metrics, protocol
numpy==2.3.4
pandas==2.3.3
pyarrow==22.0.0
scipy==1.16.3
scikit-learn==1.7.2
skrub==0.7.0  # 0.6.2 in the paper; tabpfn 9.0.0 needs 0.7, whose Tf-Idf encoding is identical
pyyaml==6.0.3
huggingface-hub==0.36.0

# string encoders
torch==2.9.1
sentence-transformers==5.2.3
transformers==4.57.3
accelerate==1.12.0

# learners of the paper
xgboost==3.1.1
catboost==1.2.8
tabpfn==9.0.0  # 6.0.6 in the paper; 9.0.0 adds TabPFN-3 and TabPFN-3.5
tabicl==2.0.3
tabstar==1.1.15
pytabkit==1.7.1

# tests
pytest==9.0.2
