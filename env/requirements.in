# The shared environment of every model on the leaderboard, at the versions of the STRABLE paper
# (2026-03-23, Python 3.12.12). env/requirements.txt is generated from this list by
# scripts/lock_env.sh, with the paper's full environment (env/paper-freeze.txt) as constraints, so
# every dependency also keeps the paper's version.
# A model that needs a package that is not here: add one line, `name==version`, and ask for it in
# the pull request text. An existing pin never changes in a pull request. The pull request then
# waits for the maintainer, who decides, relocks and rebuilds the environment.

# data, metrics, protocol
numpy==2.3.5  # 2.3.4 in the paper; EXAONE Tabular needs 2.3.5 or later
pandas==2.3.3
pyarrow==23.0.1  # 22.0.0 in the paper; autogluon 1.6 (Mitra-v2) needs 23.0.1 or later
scipy==1.16.3
scikit-learn==1.7.2
skrub==0.7.0  # 0.6.2 in the paper; tabpfn 9.0.0 needs 0.7, whose Tf-Idf encoding is identical
pyyaml==6.0.3
huggingface-hub==1.33.0  # 0.36.0 in the paper; Nori-30M needs 1.0 or later, autogluon 1.6 (Mitra-v2) below 2.0

# string encoders
torch==2.13.0  # 2.9.1 in the paper; Causilo needs 2.13 or later, Nori-30M below 2.14
sentence-transformers==5.2.3
transformers==5.20.2  # 4.57.3 in the paper; huggingface-hub 1.0 or later needs transformers 5
accelerate==1.12.0

# learners of the paper
xgboost==3.1.1
catboost==1.2.8
tabpfn==9.0.0  # 6.0.6 in the paper; 9.0.0 adds TabPFN-3 and TabPFN-3.5
tabicl==2.0.3
tabstar==1.1.15
pytabkit==1.7.1

# learners added after the paper
structured-data-models==0.2.1  # Kumo Tabular (NVIDIA)
exaonetabular @ git+https://github.com/LGAI-Research/EXAONE-Tabular.git@841927fc4f2c573db5c88325f64ecc4fe5affd12  # EXAONE Tabular (LG), not on PyPI
causilo==1.0.2  # Causilo (Nums AI)
synthefy-nori==0.21.0  # Nori-30M (Synthefy)
tabfm[pytorch]==1.0.1  # TabFM (Google)
xiaomi-tabldm @ git+https://github.com/xiaomi-research/xiaomi-tabldm.git@e83da2baaa7357f27290ebf3a1bd1cdc216b6223  # Xiaomi-TabLDM, not on PyPI
autogluon.tabular[mitra]==1.6.3  # Mitra-v2 (AutoGluon)

# dependencies the paper's freeze holds at versions the pins above cannot use
click==8.5.0  # 8.3.0 in the paper; huggingface-hub 2.2.0 needs 8.4.2 or later
hf-xet==1.7.0  # 1.2.0 in the paper; huggingface-hub 2.2.0 needs 1.6 or later
httpx==0.27.2  # 0.28.1 in the paper; synthefy, a dependency of synthefy-nori, needs below 0.28
safetensors==0.8.0  # 0.7.0 in the paper; Causilo and transformers 5.20 need 0.8 or later
tokenizers==0.23.3  # 0.22.1 in the paper; transformers 5.20 needs 0.23, and huggingface-hub 2 needs 0.23.3 or later
triton==3.7.1  # 3.5.1 in the paper; torch 2.13.0 needs it
cuda-pathfinder==1.8.3  # not in the paper; a dependency of cuda-bindings (torch 2.13), held at the version locked and checked with it
synthefy==7.2.0  # not in the paper; a dependency of synthefy-nori, held at the version locked and checked with it

# tests
pytest==9.0.2
