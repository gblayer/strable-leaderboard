# The shared environment of every model on the leaderboard, at the versions of the STRABLE paper
# (2026-03-23, Python 3.12.12). env/requirements.txt is generated from this list by
# scripts/lock_env.sh, with the paper's full environment (env/paper-freeze.txt) as constraints, so
# every dependency also keeps the paper's version.
# A model that needs a package that is not here: add one line, `name==version`, and ask for it in
# the pull request text. An existing pin never changes in a pull request. The pull request then
# waits for the maintainer, who decides, relocks and rebuilds the environment.

# data, metrics, protocol
numpy==2.3.5  # 2.3.4 in the paper; EXAONE Tabular needs 2.3.5 or later
pandas==2.3.3
pyarrow==22.0.0
scipy==1.16.3
scikit-learn==1.7.2
skrub==0.7.0  # 0.6.2 in the paper; tabpfn 9.0.0 needs 0.7, whose Tf-Idf encoding is identical
pyyaml==6.0.3
huggingface-hub==0.36.0

# string encoders
torch==2.9.1
sentence-transformers==5.2.3
transformers==4.57.3
accelerate==1.12.0

# learners of the paper
xgboost==3.1.1
catboost==1.2.8
tabpfn==9.0.0  # 6.0.6 in the paper; 9.0.0 adds TabPFN-3 and TabPFN-3.5
tabicl==2.0.3
tabstar==1.1.15
pytabkit==1.7.1

# learners added after the paper
structured-data-models==0.2.1  # Kumo Tabular (NVIDIA)
exaonetabular @ git+https://github.com/LGAI-Research/EXAONE-Tabular.git@841927fc4f2c573db5c88325f64ecc4fe5affd12  # EXAONE Tabular (LG), not on PyPI

# tests
pytest==9.0.2
